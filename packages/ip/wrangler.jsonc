{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ip",
  "main": "build/index.js",
  "compatibility_date": "2026-07-29",
  "account_id": "e5d555f9d1fca923675e48bf46bb2a6d",
  "workers_dev": false,
  "preview_urls": false,
  "route": {
    "pattern": "ip.jg.ar/*",
    "zone_name": "jg.ar"
  },
  "build": {
    "command": "cargo install -q worker-build --version 0.8.5 --locked && worker-build --release --no-panic-recovery"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
